
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
}

model DiagnosticCentre {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(150)
  location  String            @db.VarChar(255)
  tests     DiagnosticTest[]
  bookings  Booking[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model DiagnosticTest {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(150)
  price     Int
  centreId  String            @db.Uuid
  centre    DiagnosticCentre  @relation(fields: [centreId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  diagnosticTestId    String        @db.Uuid
  diagnosticCentreId  String        @db.Uuid
  appointmentDateTime DateTime
  amount              Int
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  User               User             @relation(fields: [userId], references: [id])
  DiagnosticTest     DiagnosticTest   @relation(fields: [diagnosticTestId], references: [id])
  DiagnosticCentre   DiagnosticCentre @relation(fields: [diagnosticCentreId], references: [id])

  @@index([userId])
  @@index([diagnosticTestId])
  @@index([diagnosticCentreId])
  @@index([status])
}
